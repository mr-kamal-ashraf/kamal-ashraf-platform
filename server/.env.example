# ==============================================
# Server Configuration
# ==============================================
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# ==============================================
# Frontend (CORS)
# ==============================================
CLIENT_URL=http://localhost:3000

# ==============================================
# MongoDB
# ==============================================
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=mongodb://localhost:27017/kamal_ashraf

# ==============================================
# JWT Secrets (generate with: openssl rand -base64 64)
# ==============================================
JWT_ACCESS_SECRET=replace_with_long_random_string_at_least_64_chars
JWT_REFRESH_SECRET=replace_with_different_long_random_string_at_least_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie security
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ==============================================
# Admin Seed (created automatically on first server start)
# ==============================================
ADMIN_EMAIL=teacher@example.com
ADMIN_PASSWORD=ChangeThisStrongPassword123!
ADMIN_NAME=Mr. Kamal Ashraf

# ==============================================
# Bunny Stream (Video CDN)
# ==============================================
BUNNY_API_KEY=your_bunny_api_key
BUNNY_LIBRARY_ID=your_library_id
BUNNY_PULL_ZONE=your-pullzone.b-cdn.net
BUNNY_TOKEN_AUTH_KEY=your_token_authentication_key
BUNNY_SIGNED_URL_TTL_SECONDS=14400

# ==============================================
# Security / Limits
# ==============================================
BCRYPT_SALT_ROUNDS=12
MAX_DEVICES_PER_USER=2
MAX_LOGIN_ATTEMPTS=10
LOGIN_LOCKOUT_MINUTES=60
SUBSCRIPTION_WARNING_DAYS=7
LESSON_COMPLETION_THRESHOLD=90

# ==============================================
# Rate Limits (general)
# ==============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==============================================
# DNS Servers (optional, comma-separated)
# Useful if your local DNS resolver can't query MongoDB Atlas SRV records.
# Example: DNS_SERVERS=8.8.8.8,1.1.1.1
# ==============================================
DNS_SERVERS=

# ==============================================
# AI / n8n integration
# ==============================================
# Base URL for the n8n instance's webhook endpoints (no trailing slash).
# Example (n8n Cloud): https://<your-subdomain>.app.n8n.cloud/webhook
N8N_WEBHOOK_BASE_URL=https://n8n-production-4b10.up.railway.app/webhook

# This platform's OWN automation secret, issued once by n8n's WF15 (Provision
# Platform) when the platform is onboarded. It is unique per platform and n8n
# checks it against this platform's row in the shared `platforms` collection.
# Never commit a real value — this is only a placeholder.
# (Older deployments used a single shared constant across all platforms; that is
# retired — rotate any value that was ever real.)
AUTOMATION_SECRET=replace_with_the_secret_WF15_returned_for_this_platform

# Single-tenant teacher id sent to n8n for every AI call. Used as the
# multi-tenancy filter inside the vector index - MUST match the teacher_id
# used when curriculum PDFs were indexed by WF1.
PLATFORM_TEACHER_ID=t_kamal_ashraf
# This backend's own publicly reachable base URL (no trailing slash) — n8n calls
# BACK into this backend at this address for WF5 stats / WF10 self-stats.
# Plain localhost will NOT work since n8n runs in the cloud; use a tunnel (e.g. ngrok)
# for local dev, or the real deployed hostname in production.
PLATFORM_API_HOST=http://localhost:5000

# The ONE subject this platform teaches (Arabic label). The student assistant
# is told this so it never asks "which subject?". Set it to this teacher's
# actual subject.
PLATFORM_SUBJECT=أحياء وجيولوجيا

# REQUIRED. WHO the student AI assistant is on THIS platform + its mission.
# Written as if talking to the AI. The platform sends this with every chat; it
# is injected at the TOP of the assistant's prompt as its identity. It can NOT
# weaken the fixed safety rules (no solving homework, curriculum-only) — those
# always win. Keep it short (a few lines). Example:
PLATFORM_AI_INSTRUCTIONS=انت المساعد الذكي لمنصة أستاذ كمال أشرف التعليمية، لطلبة الإعدادية والثانوية (تالتة إعدادي، أولى ثانوي، تالتة ثانوي)، في مادة الأحياء والجيولوجيا. إنت مساعد مذاكرة بيقف جنب الطالب ومكمّل لدور الأستاذ، مش بديل عنه. المنصة فيها: دروس فيديو بيشرحها أستاذ كمال، كورسات الطالب بيشتريها ويتفرّج عليها، مراجعات وامتحانات، ومتابعة لتقدّم الطالب. كل شرحك وأمثلتك لازم تطلع من محتوى دروس ومنهج الأستاذ المرفوع، مش من معلومات عامة. مهمتك: - تشرح وتبسّط أي مفهوم من دروس الأستاذ (زي تركيب الخلية، الانقسام، الوراثة، أجهزة جسم الإنسان، النبات، المعادن والصخور، التراكيب الجيولوجية والحفريات)، وتجاوب أسئلة الفهم، وتراجع مع الطالب قبل الامتحان. - توصف الرسومات والتراكيب بالكلام خطوة بخطوة، وتربط المعلومة بأمثلة من الطبيعة والحياة اليومية، وتساعده يفرّق بين المصطلحات العلمية المتشابهة ويكتبها صح. - تجهّز الطالب لأسلوب أسئلة الامتحانات في مرحلته (فهم وتطبيق ورسومات)، وتديله تشبيهات تقرّب المعلومة. - تشجّعه دايمًا إنه يرجع يتفرّج على دروس الأستاذ على المنصة ويكمّل الكورس اللي معاه. - لما يسأل عن نفسه (تقدّمه، دروسه، كورساته) طمّنه وشجّعه من غير ما تحرجه. حدود: - أي سؤال إداري (مواعيد، مصاريف، اشتراك، مشكلة في الدفع أو تقني) محوّلوش لنفسك — قول للطالب يكلّم أستاذ كمال أو الدعم، ومتخترعش أي معلومة. - متتكلمش في حاجة بره مادة الأحياء والجيولوجيا ومنهج المنصة. النبرة: محترمة وودودة ومشجّعة، بالعامية المصرية، وإيموجي خفيف في وقت التشجيع بس.

# OPTIONAL. WHO the WhatsApp support/sales assistant (WF13) is on THIS
# platform — a DIFFERENT job from PLATFORM_AI_INSTRUCTIONS above (that one is
# the student tutor; this one talks to customers/parents about courses,
# prices, payments and escalations). Sent with every inbound WhatsApp message
# and injected at the top of that agent's prompt as its identity. It can NOT
# weaken the fixed support rules (privacy, no promises, escalation) — those
# always win. If left blank, WF13 falls back to its generic built-in support
# persona. Keep it short. Example:
PLATFORM_SUPPORT_AI_INSTRUCTIONS=انت مساعد خدمة العملاء بتاع منصة أستاذ كمال أشرف التعليمية لمادة الأحياء والجيولوجيا لطلبة الإعدادية والثانوية (تالتة إعدادي، أولى ثانوي، تالتة ثانوي). اسمك يوسف. لو حد من أولياء الأمور أو العملاء سألك اسمك إيه، قوله إن اسمك يوسف، ومتقولش اسمك من نفسك ومتبدأش بيه كلامك إلا لو اتسألت. بتتكلم مع الطلبة وأولياء أمورهم على الواتساب — ودورك هنا مختلف عن مساعد المذاكرة: انت مش بتشرح دروس، انت بتساعدهم في كل حاجة تخص تعاملهم مع المنصة. مهمتك: - تعرّفهم بالكورسات المتاحة لكل مرحلة وأسعارها. - تطمّنهم على تقدّم الطالب في الكورسات اللي عنده ومدفوعاته. - ترد على أي استفسار عام عن المنصة وخدماتها. انت مساعد أستاذ كمال، مش بديل عنه — أي طلب شخصي أو شكوى أو حاجة محتاجة قراره حوّلها له مباشرة ومتحاولش تحلّها بنفسك.

# ==============================================
# Paymob payment gateway (course purchases)
# ==============================================
# Classic Paymob Accept flow (auth token -> order -> payment key -> iframe).
# Get these from your Paymob dashboard. Each teacher deployment uses its OWN
# Paymob account so money lands in that teacher's account.
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=
# Each payment method appears for students only when its id is set:
# Card (Visa / Mastercard / Meeza) — the card integration + its iframe id.
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
# Card fields INSIDE the course page (Paymob Pixel) instead of Paymob's page:
# the account's secret + public keys (dashboard → Settings → Account Info).
# With both set, IFRAME_ID isn't needed. Test keys (egy_sk_test_… /
# egy_pk_test_…) go with test integrations, live keys with live ones.
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
# Mobile wallets (Vodafone Cash, Etisalat Cash, Orange Cash, WE Pay…).
PAYMOB_WALLET_INTEGRATION_ID=
# Cash at any Aman / Masary outlet: the student gets a reference number and
# pays it there; the course opens when Paymob reports it paid. Ask Paymob how
# long a reference stays payable on your account and set the hours to match.
PAYMOB_KIOSK_INTEGRATION_ID=
# PAYMOB_KIOSK_EXPIRY_HOURS=48
# Optional — defaults to https://accept.paymob.com/api (Egypt).
# PAYMOB_BASE_URL=https://accept.paymob.com/api
#
# Paymob dashboard callbacks (NOT env — set inside Paymob, on EVERY integration
# you use: card, wallet and kiosk):
#   Transaction processed callback (POST):  https://<api-host>/api/v1/payments/paymob/webhook
#   Transaction response callback (redirect): https://<client-url>/payment/callback

# ── WhatsApp (self-hosted Baileys bridge) ─────────────────────────────────────
# WhatsApp is handled by an in-process Baileys session — no Meta credentials.
# Link the platform's number ONCE by scanning the QR from the admin panel
# (WhatsApp page); the session is stored in MongoDB and survives redeploys.
# Set to "false" to keep the bridge off (sends become logged no-ops).
WHATSAPP_BRIDGE_ENABLED=true

# Teacher WhatsApp number for support-agent escalation pings (optional).
TEACHER_SUPPORT_PHONE=

# Owner's metering proxy (the dashboard's /api/metering), used by the WhatsApp
# bridge to transcribe voice notes. The cost is debited from THIS platform's AI
# wallet, authenticated with AUTOMATION_SECRET — no OpenAI key lives here.
# Optional — leave blank to ignore voice notes.
# e.g. https://ai-edu-system-dashboard-production.up.railway.app/api/metering
METERING_PROXY_URL=

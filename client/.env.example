# Public API base URL (exposed to the browser)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# The website's public address — canonical links, sitemap.xml, share previews
# and Google structured data use it. In production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Search Console → "HTML tag" verification: paste only the content value
# (the long code), not the whole <meta> tag. Leave empty if you verify by DNS.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
